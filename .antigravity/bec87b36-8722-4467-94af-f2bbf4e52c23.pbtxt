    user_response: "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"T\303\252n s\341\272\243n ph\341\272\251m ho\341\272\267c ti\303\252u \304\221\341\273\201 b\303\240i vi\341\272\277t c\341\272\247n t\341\272\241o b\341\273\231 Quiz\",\n      \"example\": \"Tai nghe Bluetooth Sony WH-1000XM5\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"T\303\263m t\341\272\257t ng\341\272\257n g\341\273\215n n\341\273\231i dung n\341\273\225i b\341\272\255t c\341\273\247a s\341\272\243n ph\341\272\251m ho\341\272\267c b\303\240i vi\341\272\277t trong 1-3 c\303\242u\",\n      \"example\": \"Tai nghe ch\341\273\221ng \341\273\223n cao c\341\272\245p v\341\273\233i th\341\273\235i l\306\260\341\273\243ng pin 30 gi\341\273\235 v\303\240 c\303\264ng ngh\341\273\207 AI kh\341\273\255 ti\341\272\277ng \341\273\223n.\"\n    },\n    \"questions\": {\n      \"type\": \"array\",\n      \"description\": \"Danh s\303\241ch c\303\241c c\303\242u h\341\273\217i tr\341\272\257c nghi\341\273\207m ki\341\273\203u Kahoot\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"description\": \"S\341\273\221 th\341\273\251 t\341\273\261 c\303\242u h\341\273\217i, b\341\272\257t \304\221\341\272\247u t\341\273\253 1\",\n            \"example\": 1\n          },\n          \"question\": {\n            \"type\": \"string\",\n            \"description\": \"N\341\273\231i dung c\303\242u h\341\273\217i tr\341\272\257c nghi\341\273\207m ng\341\272\257n g\341\273\215n, gi\341\272\255t g\303\242n, h\341\272\245p d\341\272\253n ki\341\273\203u Kahoot\",\n            \"example\": \"Th\341\273\235i l\306\260\341\273\243ng pin t\341\273\221i \304\221a c\341\273\247a Sony WH-1000XM5 khi b\341\272\255t ch\341\273\221ng \341\273\223n l\303\240 bao nhi\303\252u?\"\n          },\n          \"options\": {\n            \"type\": \"array\",\n            \"minItems\": 4,\n            \"maxItems\": 4,\n            \"description\": \"\304\220\303\272ng 4 l\341\273\261a ch\341\273\215n tr\341\272\243 l\341\273\235i A, B, C, D\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": {\n                  \"type\": \"string\",\n                  \"enum\": [\"A\", \"B\", \"C\", \"D\"],\n                  \"description\": \"\304\220\341\273\213nh danh l\341\273\261a ch\341\273\215n, ch\341\273\211 nh\341\272\255n gi\303\241 tr\341\273\213 A, B, C ho\341\272\267c D\",\n                  \"example\": \"A\"\n                },\n                \"text\": {\n                  \"type\": \"string\",\n                  \"description\": \"N\341\273\231i dung ph\306\260\306\241ng \303\241n tr\341\272\243 l\341\273\235i\",\n                  \"example\": \"30 gi\341\273\235\"\n                }\n              },\n              \"required\": [\"id\", \"text\"]\n            }\n          },\n          \"correct_option_id\": {\n            \"type\": \"string\",\n            \"enum\": [\"A\", \"B\", \"C\", \"D\"],\n            \"description\": \"ID c\341\273\247a ph\306\260\306\241ng \303\241n \304\221\303\272ng (A, B, C ho\341\272\267c D)\",\n            \"example\": \"A\"\n          },\n          \"explanation\": {\n            \"type\": \"string\",\n            \"description\": \"Gi\341\272\243i th\303\255ch ng\341\272\257n g\341\273\215n t\341\272\241i sao \304\221\303\241p \303\241n \304\221\303\263 \304\221\303\272ng\",\n            \"example\": \"Sony WH-1000XM5 h\341\273\227 tr\341\273\243 ph\303\241t nh\341\272\241c li\303\252n t\341\273\245c l\303\252n \304\221\341\272\277n 30 gi\341\273\235 khi b\341\272\255t t\303\255nh n\304\203ng ch\341\273\221ng \341\273\223n ANC.\"\n          },\n          \"hint\": {\n            \"type\": \"string\",\n            \"nullable\": true,\n            \"description\": \"G\341\273\243i \303\275 cho c\303\242u h\341\273\217i (n\341\272\277u c\303\263)\"\n          },\n          \"difficulty\": {\n            \"type\": \"string\",\n            \"enum\": [\"EASY\", \"MEDIUM\", \"HARD\"],\n            \"description\": \"M\341\273\251c \304\221\341\273\231 kh\303\263 c\341\273\247a c\303\242u h\341\273\217i\"\n          },\n          \"time_limit_sec\": {\n            \"type\": \"integer\",\n            \"minimum\": 10,\n            \"maximum\": 60,\n            \"description\": \"Th\341\273\235i gian l\303\240m b\303\240i cho c\303\242u n\303\240y (gi\303\242y)\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"question\",\n          \"options\",\n          \"correct_option_id\",\n          \"explanation\"\n        ]\n      }\n    }\n  },\n  \"required\": [\"title\", \"summary\", \"questions\"]\n}\n\nT\303\264i c\303\263 1 c\341\272\245u tr\303\272c json nh\306\260 tr\303\252n. C\303\262n b\341\272\241n l\303\240 1 chuy\303\252n gia code v\341\273\233i h\303\240ng ch\341\273\245c n\304\203m kinh nghi\341\273\207m d\303\240y d\341\272\267n.\nB\303\242y gi\341\273\235 t\303\264i mu\341\273\221n nh\341\273\235 b\341\272\241n thi\341\272\277t k\341\272\277 cho t\303\264i 1 trang web v\341\273\233i input l\303\240 1 c\303\241i file json g\341\273\223m c\303\241c c\303\242u h\341\273\217i quizz. B\341\272\241n s\341\272\275 nh\341\272\255n c\303\241i danh s\303\241ch \304\221\303\263 r\341\273\223i t\341\272\241o ra 1 app ch\306\241i t\306\260a t\341\273\261a nh\306\260 game kahoot \303\241. Y\303\252u c\341\272\247u code ph\341\272\243i clean \304\221\306\260\341\273\243c chia r\303\265 r\303\240ng. Code d\341\273\205 \304\221\341\273\215c d\341\273\205 hi\341\273\203u d\341\273\205 b\341\272\243o tr\303\254 v\303\240 m\341\273\237 r\341\273\231ng. Giao di\341\273\207n ph\341\272\243i th\303\242n thi\341\273\207n ng\306\260\341\273\235i d\303\271ng v\303\240 \304\221\306\260\341\273\243c responsive tr\303\252n to\303\240n b\341\273\231 c\303\241c thi\341\272\277t b\341\273\213. UX d\341\273\205 ch\306\241i"
