    replacement_chunks {
      replacement_content: "import { QuizData, ValidationResult, OptionId } from \"../types\";\n\nexport function validateQuizJson(jsonString: string): ValidationResult {\n  if (!jsonString || !jsonString.trim()) {\n    return { isValid: false, error: \"D\341\273\257 li\341\273\207u JSON kh\303\264ng \304\221\306\260\341\273\243c \304\221\341\273\203 tr\341\273\221ng.\" };\n  }\n\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(jsonString);\n  } catch (err: unknown) {\n    const message = err instanceof Error ? err.message : String(err);\n    return {\n      isValid: false,\n      error: `C\303\272 ph\303\241p JSON kh\303\264ng h\341\273\243p l\341\273\207: ${message}`\n    };\n  }\n\n  if (typeof parsed !== \"object\" || parsed === null || Array.isArray(parsed)) {\n    return {\n      isValid: false,\n      error: \"C\341\272\245u tr\303\272c JSON ph\341\272\243i l\303\240 m\341\273\231t \304\221\341\273\221i t\306\260\341\273\243ng (Object) ch\341\273\251a \'title\', \'summary\' v\303\240 \'questions\'.\"\n    };\n  }\n\n  const obj = parsed as Record<string, unknown>;\n\n  if (typeof obj.title !== \"string\" || !obj.title.trim()) {\n    return {\n      isValid: false,\n      error: \"Tr\306\260\341\273\235ng \'title\' b\341\273\213 thi\341\272\277u ho\341\272\267c kh\303\264ng ph\341\272\243i l\303\240 chu\341\273\227i k\303\275 t\341\273\261.\"\n    };\n  }\n\n  if (typeof obj.summary !== \"string\") {\n    return {\n      isValid: false,\n      error: \"Tr\306\260\341\273\235ng \'summary\' b\341\273\213 thi\341\272\277u ho\341\272\267c kh\303\264ng ph\341\272\243i l\303\240 chu\341\273\227i k\303\275 t\341\273\261.\"\n    };\n  }\n\n  if (!Array.isArray(obj.questions) || obj.questions.length === 0) {\n    return {\n      isValid: false,\n      error: \"Tr\306\260\341\273\235ng \'questions\' ph\341\272\243i l\303\240 m\341\273\231t m\341\272\243ng danh s\303\241ch c\303\242u h\341\273\217i v\303\240 ph\341\272\243i ch\341\273\251a \303\255t nh\341\272\245t 1 c\303\242u h\341\273\217i.\"\n    };\n  }\n\n  const validOptionIds: OptionId[] = [\"A\", \"B\", \"C\", \"D\"];\n\n  for (let i = 0; i < obj.questions.length; i++) {\n    const q = obj.questions[i];\n    const qIndexStr = `C\303\242u h\341\273\217i #${i + 1}`;\n\n    if (typeof q !== \"object\" || q === null) {\n      return {\n        isValid: false,\n        error: `${qIndexStr} kh\303\264ng \304\221\303\272ng \304\221\341\273\213nh d\341\272\241ng \304\221\341\273\221i t\306\260\341\273\243ng.`\n      };\n    }\n\n    const qObj = q as Record<string, unknown>;\n\n    if (typeof qObj.question !== \"string\" || !qObj.question.trim()) {\n      return {\n        isValid: false,\n        error: `${qIndexStr}: N\341\273\231i dung \'question\' b\341\273\213 thi\341\272\277u ho\341\272\267c tr\341\273\221ng.`\n      };\n    }\n\n    if (!Array.isArray(qObj.options) || qObj.options.length !== 4) {\n      return {\n        isValid: false,\n        error: `${qIndexStr}: \'options\' ph\341\272\243i ch\341\273\251a \304\221\303\272ng 4 l\341\273\261a ch\341\273\215n (A, B, C, D).`\n      };\n    }\n\n    const seenIds = new Set<string>();\n    for (let optIdx = 0; optIdx < qObj.options.length; optIdx++) {\n      const opt = qObj.options[optIdx];\n      if (typeof opt !== \"object\" || opt === null) {\n        return {\n          isValid: false,\n          error: `${qIndexStr}, l\341\273\261a ch\341\273\215n th\341\273\251 ${optIdx + 1}: \304\220\341\273\213nh d\341\272\241ng l\341\273\261a ch\341\273\215n kh\303\264ng h\341\273\243p l\341\273\207.`\n        };\n      }\n\n      const optObj = opt as Record<string, unknown>;\n      const optId = String(optObj.id);\n\n      if (!validOptionIds.includes(optId as OptionId)) {\n        return {\n          isValid: false,\n          error: `${qIndexStr}: \304\220\341\273\213nh danh L\341\273\261a ch\341\273\215n \'id\' ph\341\272\243i l\303\240 m\341\273\231t trong c\303\241c gi\303\241 tr\341\273\213 [\'A\', \'B\', \'C\', \'D\']. Nh\341\272\255n \304\221\306\260\341\273\243c: \'${optId}\'.`\n        };\n      }\n\n      if (seenIds.has(optId)) {\n        return {\n          isValid: false,\n          error: `${qIndexStr}: Ph\303\241t hi\341\273\207n tr\303\271ng l\341\272\267p l\341\273\261a ch\341\273\215n \'id\' \'${optId}\'.`\n        };\n      }\n      seenIds.add(optId);\n\n      if (typeof optObj.text !== \"string\" || !optObj.text.trim()) {\n        return {\n          isValid: false,\n          error: `${qIndexStr}, l\341\273\261a ch\341\273\215n ${optId}: N\341\273\231i dung \'text\' kh\303\264ng \304\221\306\260\341\273\243c \304\221\341\273\203 tr\341\273\221ng.`\n        };\n      }\n    }\n\n    const correctId = String(qObj.correct_option_id);\n    if (!validOptionIds.includes(correctId as OptionId)) {\n      return {\n        isValid: false,\n        error: `${qIndexStr}: \'correct_option_id\' ph\341\272\243i l\303\240 \'A\', \'B\', \'C\' ho\341\272\267c \'D\'. Nh\341\272\255n \304\221\306\260\341\273\243c: \'${correctId}\'.`\n      };\n    }\n\n    if (typeof qObj.explanation !== \"string\" || !qObj.explanation.trim()) {\n      return {\n        isValid: false,\n        error: `${qIndexStr}: \'explanation\' (gi\341\272\243i th\303\255ch) kh\303\264ng \304\221\306\260\341\273\243c \304\221\341\273\203 tr\341\273\221ng.`\n      };\n    }\n\n    // Optional fields sanitize\n    if (qObj.time_limit_sec !== undefined && qObj.time_limit_sec !== null) {\n      const sec = Number(qObj.time_limit_sec);\n      if (isNaN(sec) || sec < 5 || sec > 180) {\n        qObj.time_limit_sec = 20; // fallback to default safe value\n      }\n    } else {\n      qObj.time_limit_sec = 20;\n    }\n\n    if (!qObj.difficulty || ![\"EASY\", \"MEDIUM\", \"HARD\"].includes(String(qObj.difficulty))) {\n      qObj.difficulty = \"MEDIUM\";\n    }\n\n    if (!qObj.id) {\n      qObj.id = i + 1;\n    }\n  }\n\n  return {\n    isValid: true,\n    quizData: parsed as QuizData\n  };\n}\n\nexport function formatJsonString(data: object): string {\n  return JSON.stringify(data, null, 2);\n}\n"
    }
