      replacement_content: "import { QuizData } from \"../types\";\n\nexport const SAMPLE_QUIZZES: { id: string; name: string; data: QuizData }[] = [\n  {\n    id: \"sony-wh1000xm5\",\n    name: \"Sony WH-1000XM5 (M\341\272\253u t\341\273\253 y\303\252u c\341\272\247u)\",\n    data: {\n      title: \"Tai nghe Bluetooth Sony WH-1000XM5\",\n      summary: \"Tai nghe ch\341\273\221ng \341\273\223n cao c\341\272\245p v\341\273\233i th\341\273\235i l\306\260\341\273\243ng pin 30 gi\341\273\235 v\303\240 c\303\264ng ngh\341\273\207 AI kh\341\273\255 ti\341\272\277ng \341\273\223n \304\221\341\273\211nh cao.\",\n      questions: [\n        {\n          id: 1,\n          question: \"Th\341\273\235i l\306\260\341\273\243ng pin t\341\273\221i \304\221a c\341\273\247a Sony WH-1000XM5 khi b\341\272\255t t\303\255nh n\304\203ng ch\341\273\221ng \341\273\223n (ANC) l\303\240 bao nhi\303\252u?\",\n          options: [\n            { id: \"A\", text: \"30 gi\341\273\235\" },\n            { id: \"B\", text: \"20 gi\341\273\235\" },\n            { id: \"C\", text: \"40 gi\341\273\235\" },\n            { id: \"D\", text: \"15 gi\341\273\235\" }\n          ],\n          correct_option_id: \"A\",\n          explanation: \"Sony WH-1000XM5 h\341\273\227 tr\341\273\243 ph\303\241t nh\341\272\241c li\303\252n t\341\273\245c l\303\252n \304\221\341\272\277n 30 gi\341\273\235 khi b\341\272\255t t\303\255nh n\304\203ng ch\341\273\221ng \341\273\223n ANC v\303\240 l\303\252n \304\221\341\272\277n 40 gi\341\273\235 khi t\341\272\257t ANC.\",\n          hint: \"Nhi\341\273\201u h\306\241n m\341\273\231t ng\303\240y \304\221\303\252m ph\303\241t nh\341\272\241c li\303\252n t\341\273\245c!\",\n          difficulty: \"EASY\",\n          time_limit_sec: 20\n        },\n        {\n          id: 2,\n          question: \"Sony WH-1000XM5 trang b\341\273\213 bao nhi\303\252u micro \304\221\341\273\203 ph\341\273\245c v\341\273\245 c\303\264ng ngh\341\273\207 thu \303\242m v\303\240 ch\341\273\221ng \341\273\223n?\",\n          options: [\n            { id: \"A\", text: \"4 micro\" },\n            { id: \"B\", text: \"6 micro\" },\n            { id: \"C\", text: \"8 micro\" },\n            { id: \"D\", text: \"10 micro\" }\n          ],\n          correct_option_id: \"C\",\n          explanation: \"WH-1000XM5 s\341\273\237 h\341\273\257u h\341\273\207 th\341\273\221ng 8 micro k\341\272\277t h\341\273\243p v\341\273\233i b\341\273\231 x\341\273\255 l\303\275 ch\341\273\221ng \341\273\223n HD QN1 v\303\240 V1 gi\303\272p l\341\273\215c ti\341\272\277ng \341\273\223n v\306\260\341\273\243t tr\341\273\231i.\",\n          hint: \"S\341\273\221 micro g\341\272\245p \304\221\303\264i th\341\272\277 h\341\273\207 tr\306\260\341\273\233c \341\273\237 m\341\273\227i b\303\252n tai nghe.\",\n          difficulty: \"MEDIUM\",\n          time_limit_sec: 20\n        },\n        {\n          id: 3,\n          question: \"T\303\255nh n\304\203ng th\303\264ng minh n\303\240o t\341\273\261 \304\221\341\273\231ng d\341\273\253ng nh\341\272\241c khi b\341\272\241n b\341\272\257t \304\221\341\272\247u n\303\263i chuy\341\273\207n?\",\n          options: [\n            { id: \"A\", text: \"Speak-to-Chat\" },\n            { id: \"B\", text: \"Quick Attention\" },\n            { id: \"C\", text: \"Adaptive Sound Control\" },\n            { id: \"D\", text: \"Auto Voice Mute\" }\n          ],\n          correct_option_id: \"A\",\n          explanation: \"T\303\255nh n\304\203ng Speak-to-Chat t\341\273\261 \304\221\341\273\231ng nh\341\272\255n di\341\273\207n gi\341\273\215ng n\303\263i c\341\273\247a b\341\272\241n, t\341\272\241m d\341\273\253ng nh\341\272\241c v\303\240 m\341\273\237 ch\341\272\277 \304\221\341\273\231 xuy\303\252n \303\242m \304\221\341\273\203 b\341\272\241n tr\303\262 chuy\341\273\207n m\303\240 kh\303\264ng c\341\272\247n th\303\241o tai nghe.\",\n          hint: \"T\303\252n t\303\255nh n\304\203ng k\341\272\277t h\341\273\243p gi\341\273\257a \'N\303\263i\' v\303\240 \'Tr\303\262 chuy\341\273\207n\'.\",\n          difficulty: \"MEDIUM\",\n          time_limit_sec: 25\n        },\n        {\n          id: 4,\n          question: \"Th\341\273\235i gian s\341\272\241c nhanh 3 ph\303\272t b\341\272\261ng c\341\273\247 s\341\272\241c USB-PD t\306\260\306\241ng th\303\255ch mang l\341\272\241i bao nhi\303\252u gi\341\273\235 s\341\273\255 d\341\273\245ng?\",\n          options: [\n            { id: \"A\", text: \"1 gi\341\273\235\" },\n            { id: \"B\", text: \"3 gi\341\273\235\" },\n            { id: \"C\", text: \"5 gi\341\273\235\" },\n            { id: \"D\", text: \"30 ph\303\272t\" }\n          ],\n          correct_option_id: \"B\",\n          explanation: \"Ch\341\273\211 v\341\273\233i 3 ph\303\272t s\341\272\241c b\341\272\261ng b\341\273\231 s\341\272\241c USB Power Delivery (USB-PD) chu\341\272\251n, tai nghe c\303\263 th\341\273\203 ho\341\272\241t \304\221\341\273\231ng li\303\252n t\341\273\245c trong 3 gi\341\273\235.\",\n          hint: \"S\341\273\221 ph\303\272t s\341\272\241c t\306\260\306\241ng \341\273\251ng tr\341\273\261c ti\341\272\277p v\341\273\233i s\341\273\221 gi\341\273\235 nghe nh\341\272\241c!\",\n          difficulty: \"HARD\",\n          time_limit_sec: 20\n        },\n        {\n          id: 5,\n          question: \"Chu\341\272\251n codec \303\242m thanh kh\303\264ng d\303\242y \304\221\341\273\231 ph\303\242n gi\341\272\243i cao \304\221\341\273\231c quy\341\273\201n c\341\273\247a Sony h\341\273\227 tr\341\273\243 tr\303\252n XM5 l\303\240 g\303\254?\",\n          options: [\n            { id: \"A\", text: \"aptX HD\" },\n            { id: \"B\", text: \"LDAC\" },\n            { id: \"C\", text: \"AAC Plus\" },\n            { id: \"D\", text: \"SBC Ultra\" }\n          ],\n          correct_option_id: \"B\",\n          explanation: \"LDAC l\303\240 c\303\264ng ngh\341\273\207 m\303\243 h\303\263a \303\242m thanh \304\221\341\273\231c quy\341\273\201n c\341\273\247a Sony, truy\341\273\201n d\341\273\257 li\341\273\207u nhi\341\273\201u h\306\241n g\341\272\245p 3 l\341\272\247n so v\341\273\233i Bluetooth SBC th\303\264ng th\306\260\341\273\235ng.\",\n          hint: \"Vi\341\272\277t t\341\272\257t c\341\273\247a Lossless High-Resolution Audio Codec do Sony ph\303\241t tri\341\273\203n.\",\n          difficulty: \"MEDIUM\",\n          time_limit_sec: 20\n        }\n      ]\n    }\n  },\n  {\n    id: \"ai-revolution-2026\",\n    name: \"Tr\303\255 Tu\341\273\207 Nh\303\242n T\341\272\241o & C\303\264ng Ngh\341\273\207 AI\",\n    data: {\n      title: \"Tr\303\255 Tu\341\273\207 Nh\303\242n T\341\272\241o & K\341\273\267 Nguy\303\252n AI\",\n      summary: \"B\341\273\231 c\303\242u h\341\273\217i th\303\272 v\341\273\213 v\341\273\201 M\303\264 h\303\254nh ng\303\264n ng\341\273\257 l\341\273\233n (LLM), Generative AI v\303\240 s\341\273\261 ph\303\241t tri\341\273\203n v\306\260\341\273\243t b\341\272\255c c\341\273\247a tr\303\255 tu\341\273\207 nh\303\242n t\341\272\241o.\",\n      questions: [\n        {\n          id: 1,\n          question: \"Thu\341\272\255t ng\341\273\257 \'LLM\' trong l\304\251nh v\341\273\261c AI l\303\240 vi\341\272\277t t\341\272\257t c\341\273\247a t\341\273\253 n\303\240o?\",\n          options: [\n            { id: \"A\", text: \"Large Language Model\" },\n            { id: \"B\", text: \"Logic & Learning Machine\" },\n            { id: \"C\", text: \"Linear Learning Module\" },\n            { id: \"D\", text: \"Linked Language Memory\" }\n          ],\n          correct_option_id: \"A\",\n          explanation: \"Large Language Model (M\303\264 h\303\254nh ng\303\264n ng\341\273\257 l\341\273\233n) l\303\240 lo\341\272\241i m\303\264 h\303\254nh tr\303\255 tu\341\273\207 nh\303\242n t\341\272\241o \304\221\306\260\341\273\243c hu\341\272\245n luy\341\273\207n tr\303\252n kh\341\273\221i l\306\260\341\273\243ng d\341\273\257 li\341\273\207u v\304\203n b\341\272\243n kh\341\273\225ng l\341\273\223.\",\n          hint: \"Li\303\252n quan \304\221\341\272\277n \'Ng\303\264n ng\341\273\257\' v\303\240 \'K\303\255ch th\306\260\341\273\233c l\341\273\233n\'.\",\n          difficulty: \"EASY\",\n          time_limit_sec: 15\n        },\n        {\n          id: 2,\n          question: \"Ki\341\272\277n tr\303\272c m\341\272\241ng th\341\272\247n kinh n\303\240o ra \304\221\341\273\235i n\304\203m 2017 t\341\272\241o n\303\252n b\306\260\341\273\233c ngo\341\272\267t b\303\271ng n\341\273\225 cho GenAI ng\303\240y nay?\",\n          options: [\n            { id: \"A\", text: \"CNN (Convolutional Network)\" },\n            { id: \"B\", text: \"RNN (Recurrent Network)\" },\n            { id: \"C\", text: \"Transformer\" },\n            { id: \"D\", text: \"Autoencoder\" }\n          ],\n          correct_option_id: \"C\",\n          explanation: \"Ki\341\272\277n tr\303\272c Transformer gi\341\273\233i thi\341\273\207u b\341\273\237i Google n\304\203m 2017 v\341\273\233i c\306\241 ch\341\272\277 Attention (Ch\303\272 \303\275) \304\221\303\243 c\303\241ch m\341\272\241ng h\303\263a x\341\273\255 l\303\275 ng\303\264n ng\341\273\257 t\341\273\261 nhi\303\252n.\",\n          hint: \"Tr\303\271ng t\303\252n v\341\273\233i lo\341\272\241t phim ng\306\260\341\273\235i m\303\241y bi\341\272\277n h\303\254nh n\341\273\225i ti\341\272\277ng!\",\n          difficulty: \"MEDIUM\",\n          time_limit_sec: 20\n        },\n        {\n          id: 3,\n          question: \"Hi\341\273\207n t\306\260\341\273\243ng AI \304\221\306\260a ra c\303\242u tr\341\272\243 l\341\273\235i sai ho\341\272\267c t\341\273\261 b\341\273\213a ra th\303\264ng tin kh\303\264ng c\303\263 th\341\272\255t g\341\273\215i l\303\240 g\303\254?\",\n          options: [\n            { id: \"A\", text: \"Amnesia (M\341\272\245t tr\303\255 nh\341\273\233)\" },\n            { id: \"B\", text: \"Hallucination (\341\272\242o gi\303\241c)\" },\n            { id: \"C\", text: \"Overfitting (Qu\303\241 kh\341\273\233p)\" },\n            { id: \"D\", text: \"Drifting (Tr\303\264i d\341\272\241t)\" }\n          ],\n          correct_option_id: \"B\",\n          explanation: \"Hallucination (\341\272\242o gi\303\241c AI) m\303\264 t\341\272\243 hi\341\273\207n t\306\260\341\273\243ng AI t\341\272\241o ra th\303\264ng tin tr\303\264ng c\303\263 v\341\272\273 t\341\273\261 tin v\303\240 h\341\273\243p l\303\275 nh\306\260ng ho\303\240n to\303\240n sai s\341\273\261 th\341\272\255t.\",\n          hint: \"M\341\273\231t hi\341\273\207n t\306\260\341\273\243ng th\341\273\213 gi\303\241c/th\303\255nh gi\303\241c b\341\272\245t th\306\260\341\273\235ng \341\273\237 con ng\306\260\341\273\235i.\",\n          difficulty: \"EASY\",\n          time_limit_sec: 20\n        },\n        {\n          id: 4,\n          question: \"K\341\273\271 thu\341\272\255t \'RAG\' gi\303\272p c\341\272\243i thi\341\273\207n \304\221\341\273\231 ch\303\255nh x\303\241c c\341\273\247a AI b\341\272\261ng c\303\241ch k\341\272\277t n\341\273\221i d\341\273\257 li\341\273\207u b\303\252n ngo\303\240i l\303\240 vi\341\272\277t t\341\272\257t c\341\273\247a g\303\254?\",\n          options: [\n            { id: \"A\", text: \"Retrieval-Augmented Generation\" },\n            { id: \"B\", text: \"Random Algorithmic Guidance\" },\n            { id: \"C\", text: \"Rapid Automated Generation\" },\n            { id: \"D\", text: \"Recursive Reasoning Agent\" }\n          ],\n          correct_option_id: \"A\",\n          explanation: \"RAG (Retrieval-Augmented Generation) gi\303\272p m\303\264 h\303\254nh truy xu\341\272\245t t\303\240i li\341\273\207u n\341\273\231i b\341\273\231 ho\341\272\267c d\341\273\257 li\341\273\207u m\341\273\233i nh\341\272\245t tr\306\260\341\273\233c khi t\341\273\225ng h\341\273\243p c\303\242u tr\341\272\243 l\341\273\235i.\",\n          hint: \"G\341\273\223m t\341\273\253 \'Retrieval\' (Truy xu\341\272\245t) v\303\240 \'Generation\' (T\341\272\241o).\",\n          difficulty: \"HARD\",\n          time_limit_sec: 25\n        }\n      ]\n    }\n  },\n  {\n    id: \"space-universe\",\n    name: \"V\305\251 Tr\341\273\245 & Thi\303\252n V\304\203n H\341\273\215c\",\n    data: {\n      title: \"H\303\240nh Tr\303\254nh Kh\303\241m Ph\303\241 V\305\251 Tr\341\273\245\",\n      summary: \"Kh\303\241m ph\303\241 c\303\241c b\303\255 \341\272\251n k\341\273\263 th\303\272 v\341\273\201 H\341\273\207 M\341\272\267t Tr\341\273\235i, ng\303\264i sao v\303\240 v\341\272\255n t\341\273\221c \303\241nh s\303\241ng qua b\341\273\231 tr\341\272\257c nghi\341\273\207m Kahoot h\341\272\245p d\341\272\253n.\",\n      questions: [\n        {\n          id: 1,\n          question: \"H\303\240nh tinh n\303\240o trong H\341\273\207 M\341\272\267t Tr\341\273\235i \304\221\306\260\341\273\243c m\341\273\207nh danh l\303\240 \'H\303\240nh tinh \304\220\341\273\217\'?\",\n          options: [\n            { id: \"A\", text: \"Sao Kim (Venus)\" },\n            { id: \"B\", text: \"Sao H\341\273\217a (Mars)\" },\n            { id: \"C\", text: \"Sao M\341\273\231c (Jupiter)\" },\n            { id: \"D\", text: \"Sao Th\341\273\247y (Mercury)\" }\n          ],\n          correct_option_id: \"B\",\n          explanation: \"Sao H\341\273\217a c\303\263 m\303\240u \304\221\341\273\217 do b\341\273\201 m\341\272\267t ch\341\273\251a l\306\260\341\273\243ng l\341\273\233n s\341\272\257t oxit (g\341\273\211 s\341\272\257t) t\341\272\241o n\303\252n v\341\272\273 ngo\303\240i \304\221\341\273\217 cam r\341\273\261c r\341\273\241.\",\n          hint: \"T\303\252n v\341\273\213 th\341\272\247n chi\341\272\277n tranh trong th\341\272\247n tho\341\272\241i La M\303\243.\",\n          difficulty: \"EASY\",\n          time_limit_sec: 15\n        },\n        {\n          id: 2,\n          question: \"\303\201nh s\303\241ng t\341\273\253 M\341\272\267t Tr\341\273\235i m\341\272\245t kho\341\272\243ng bao l\303\242u \304\221\341\273\203 di chuy\341\273\203n \304\221\341\272\277n Tr\303\241i \304\220\341\272\245t?\",\n          options: [\n            { id: \"A\", text: \"8 ph\303\272t 20 gi\303\242y\" },\n            { id: \"B\", text: \"1 gi\303\242y\" },\n            { id: \"C\", text: \"1 gi\341\273\235 15 ph\303\272t\" },\n            { id: \"D\", text: \"24 gi\341\273\235\" }\n          ],\n          correct_option_id: \"A\",\n          explanation: \"V\341\273\233i kho\341\272\243ng c\303\241ch x\341\272\245p x\341\273\211 150 tri\341\273\207u km v\303\240 t\341\273\221c \304\221\341\273\231 \303\241nh s\303\241ng ~300.000 km/s, \303\241nh s\303\241ng m\341\272\245t kho\341\272\243ng 500 gi\303\242y (~8 ph\303\272t 20 gi\303\242y) \304\221\341\273\203 t\341\273\233i Tr\303\241i \304\220\341\272\245t.\",\n          hint: \"\303\215t h\306\241n 10 ph\303\272t m\341\273\231t ch\303\272t!\",\n          difficulty: \"MEDIUM\",\n          time_limit_sec: 20\n        },\n        {\n          id: 3,\n          question: \"K\303\255nh thi\303\252n v\304\203n kh\303\264ng gian h\303\240ng \304\221\341\272\247u th\341\272\277 gi\341\273\233i \304\221\306\260\341\273\243c ph\303\263ng n\304\203m 2021 thay th\341\272\277 cho Hubble c\303\263 t\303\252n l\303\240 g\303\254?\",\n          options: [\n            { id: \"A\", text: \"Kepler\" },\n            { id: \"B\", text: \"James Webb (JWST)\" },\n            { id: \"C\", text: \"Spitzer\" },\n            { id: \"D\", text: \"Chandra\" }\n          ],\n          correct_option_id: \"B\",\n          explanation: \"K\303\255nh thi\303\252n v\304\203n James Webb (JWST) quan s\303\241t \341\273\237 d\341\272\243i s\303\263ng h\341\273\223ng ngo\341\272\241i, gi\303\272p ch\341\273\245p nh\341\273\257ng b\341\273\251c \341\272\243nh v\305\251 tr\341\273\245 s\303\242u ch\306\260a t\341\273\253ng c\303\263.\",\n          hint: \"\304\220\341\272\267t theo t\303\252n v\341\273\213 qu\341\272\243n tr\341\273\213 vi\303\252n th\341\273\251 2 c\341\273\247a NASA.\",\n          difficulty: \"EASY\",\n          time_limit_sec: 15\n        }\n      ]\n    }\n  }\n];\n"
    }
